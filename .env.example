# ==============================================================================
# LedgerLine Core - Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env (and server/.env) AND CONFIGURE SECRETS.
# NEVER COMMIT ACTUAL PASSWORDS OR SECRETS TO VERSION CONTROL.
# ==============================================================================

# Server Configuration
PORT=5000
HOST=localhost
NODE_ENV=development

# PostgreSQL Database Configuration (Runtime Application Role)
# IMPORTANT: Application role must be ledgerline_app with least-privilege grants.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ledgerline_dev
DB_USER=ledgerline_app
DB_PASSWORD=your_secure_app_role_password_here
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=2000

# Administrative Database Configuration (Bootstrap & Migrations Only)
ADMIN_DB_USER=postgres
ADMIN_DB_PASSWORD=your_postgres_admin_password_here

# Security Secrets
# IDENTITY_HMAC_SECRET: Must be exactly 32 cryptographically random bytes represented as 64 hex characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IDENTITY_HMAC_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# JWT_SECRET: Must be a strong cryptographically secure string (minimum 32 characters).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars_long

# Versioned HMAC Secret Configuration (Default 1; increment when rotating)
HMAC_KEY_VERSION=1

# Initial Administrator Credentials (Bootstrap only - hashed via scrypt)
INITIAL_ADMIN_EMAIL=admin@ledgerline.local
INITIAL_ADMIN_PASSWORD=your_initial_admin_strong_password_here

# Client Origin for CORS
CLIENT_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5000
