# ==============================================================================
# LedgerLine Core - Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env AND FILL IN YOUR LOCAL CREDENTIALS.
# NEVER COMMIT ACTUAL SECRETS OR PASSWORDS TO VERSION CONTROL.
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=5000
HOST=localhost

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ledgerline_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=2000

# Client Application / CORS Configuration
CLIENT_ORIGIN=http://localhost:5173

# Frontend (Vite) API Base URL (used if client reads from root or client/.env)
VITE_API_BASE_URL=http://localhost:5000

